{
  "name": "hometrack",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "web": "turbo run dev --filter=web",
    "mobile": "turbo run dev --filter=mobile"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "piscina": "^4.9.3",
    "valibot": "^1.2.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": {
        "brace-expansion": "^5.0.8"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.12.1"
}
